{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duplicate Cleaner",
  "version": "1.0.0",
  "identifier": "com.duplicatecleaner.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Duplicate Cleaner",
        "width": 1360,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#141416",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Find and safely remove duplicate files",
    "longDescription": "Duplicate Cleaner scans your disks, finds files with identical content, visually similar photos and the largest files, and safely moves redundant copies to the Recycle Bin.",
    "copyright": "© 2026 Duplicate Cleaner",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "Russian"
        ],
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": [
          "en-US",
          "ru-RU"
        ]
      }
    }
  }
}
